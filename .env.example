# Copy to .env and adjust. Placeholder values only; never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Services
MONGODB_URI=mongodb://127.0.0.1:27017/atlasmotion
REDIS_URL=redis://127.0.0.1:6379

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-64-hex-chars
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Storage: "local" for development, "s3" for production (any S3-compatible service)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage
# WORK_DIR=./storage/tmp
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
DOWNLOAD_URL_TTL_SECONDS=300

# AI storyboard planner (optional). Without a key the offline gazetteer planner is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PLANNER_DEFAULT=auto

# Satellite imagery. Close-ups use detail tiles fetched by the server (never by the browser);
# the globe and anything the tiles cannot cover use the bundled NASA Blue Marble image.
#   eox-s2cloudless  Sentinel-2 cloudless 2016 by EOX, CC BY 4.0, no key (default)
#   maptiler-satellite  MapTiler Satellite: needs SATELLITE_TILE_KEY and SATELLITE_VIDEO_LICENSE=flex|custom
#                    (the MapTiler video licence you hold). Tiles are never cached on disk or proxied to the preview.
#   custom           your own provider: set SATELLITE_TILE_URL, SATELLITE_ATTRIBUTION, and SATELLITE_TILE_KEY if the URL has {key}
#   none             Blue Marble only, fully offline
# Use only a provider whose terms allow imagery in exported video. Google Maps tiles do not.
SATELLITE_PROVIDER=eox-s2cloudless
# SATELLITE_TILE_URL=https://example-provider.com/satellite/{z}/{x}/{y}.jpg?key={key}
# SATELLITE_TILE_KEY=
# SATELLITE_ATTRIBUTION=
# SATELLITE_MAX_ZOOM=13
# SATELLITE_VIDEO_LICENSE=
# Prepared imagery regions (sharp Copernicus Sentinel-2 tiles built by scripts/imagery/bake_sentinel2.py)
# are used before the provider wherever they cover the view.
# SATELLITE_REGIONS_DIR=assets/imagery/regions

# 3D terrain view (base map "3D"): headless Chromium draws the globe with terrain and a tilted camera.
# CHROMIUM_PATH=/usr/bin/chromium        # defaults to Playwright's Chromium when installed
# Elevation tiles in Terrarium PNG encoding; "none" draws the 3D view without relief.
# TERRAIN_TILE_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png
# TERRAIN_ATTRIBUTION=Terrain: Mapzen Terrain Tiles on AWS (SRTM, GMTED2010, ETOPO1 and others)
# TERRAIN_MAX_ZOOM=12

# Live Google Maps satellite preview in the editor (Maps JavaScript API). Preview only: Google imagery is
# never drawn into exported videos, because Google's terms do not allow it (docs/IMAGERY_LICENSING.md).
# This is a browser key, visible to the browser by design. In Google Cloud, restrict it to your site's
# HTTP referrers and to the Maps JavaScript API only.
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_MAP_ID=

# Narration: espeak-ng must be installed on the worker host
TTS_DEFAULT=espeak-ng

# Rendering and limits
RENDER_CONCURRENCY=1
RENDER_MAX_ATTEMPTS=3
MAX_PROJECT_SECONDS=180
USAGE_RENDERS_PER_DAY=20
USAGE_PLANS_PER_HOUR=30
TEMP_RETENTION_HOURS=24

# Optional binary overrides
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# ESPEAK_PATH=espeak-ng
