# Copy to .env and adjust. Placeholder values only; never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Services
MONGODB_URI=mongodb://127.0.0.1:27017/atlasmotion
REDIS_URL=redis://127.0.0.1:6379

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-64-hex-chars
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Storage: "local" for development, "s3" for production (any S3-compatible service)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage
# WORK_DIR=./storage/tmp
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
DOWNLOAD_URL_TTL_SECONDS=300

# AI storyboard planner (optional). Without a key the offline gazetteer planner is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PLANNER_DEFAULT=auto

# Narration: espeak-ng must be installed on the worker host
TTS_DEFAULT=espeak-ng

# Rendering and limits
RENDER_CONCURRENCY=1
RENDER_MAX_ATTEMPTS=3
MAX_PROJECT_SECONDS=180
USAGE_RENDERS_PER_DAY=20
USAGE_PLANS_PER_HOUR=30
TEMP_RETENTION_HOURS=24

# Optional binary overrides
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# ESPEAK_PATH=espeak-ng
